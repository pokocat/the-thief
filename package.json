{
  "name": "heist-td",
  "version": "0.1.0",
  "description": "怪盗塔防 (Heist TD) — original 3D cartoon-fantasy tower defense prototype (Babylon.js).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx scripts/smoke.ts",
    "smoke:lose": "MODE=lose tsx scripts/smoke.ts"
  },
  "license": "MIT",
  "devDependencies": {
    "playwright": "^1.61.0",
    "tsx": "^4.22.4",
    "typescript": "^5.5.4",
    "vite": "^5.4.2"
  },
  "dependencies": {
    "@babylonjs/core": "^7.20.0"
  }
}
